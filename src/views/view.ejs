<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    
    <!-- Tailwind CSS -->
    <link href="/tailwind.css" rel="stylesheet">
    <!-- Plyr CSS -->
    <link rel="stylesheet" href="/plyr.css" />
    <!-- Roboto Font -->
    <link href="/roboto.css" rel="stylesheet">

    <script src="socket.io.js"></script>
    <script src="renderer.js"></script>

    <script>
        // Socket.io and shared utilities are initialized in renderer.js
    </script>


    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <!-- Toast Container -->
    <div class="fixed bottom-0 right-0 p-3 z-50 flex flex-col gap-2"></div>
    
    <nav class="sticky top-0 bg-gray-900/95 backdrop-blur-sm border-b border-gray-800 z-40 mb-6">
        <div class="container mx-auto px-4 py-2">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <a class="flex items-center no-underline text-white" href="/">
                    <img src="/favicon.ico" width="30" height="30" class="mr-2" alt="">
                    <div class="flex flex-col">
                        <strong class="text-lg">YouTube Downloader</strong>
                        <span class="text-[0.65rem] text-gray-400 -mt-1">v<%= typeof appVersion !== 'undefined' ? appVersion : '' %></span>
                    </div>
                </a>
                
                <div class="flex-grow flex justify-center mx-4 min-w-[300px]">
                    <form id="commandForm" class="flex flex-col w-full max-w-2xl m-0">
                        <div class="flex w-full items-center">
                            <input class="flex-grow bg-gray-800 text-white border border-gray-700 rounded-full px-4 py-1.5 mr-2 focus:outline-none focus:border-blue-500" type="text" id="commandInput" placeholder="Coller une URL YouTube..." required>
                            <button class="bg-transparent hover:bg-white text-white hover:text-gray-900 border border-white rounded-full px-4 py-1.5 transition-colors whitespace-nowrap" type="submit">Télécharger</button>
                            <button type="button" class="bg-gray-800 hover:bg-gray-700 text-white border border-gray-600 rounded-full w-9 h-9 flex items-center justify-center ml-2 transition-colors" title="Changer le dossier de téléchargement" onclick="changeFolder()">📂</button>
                        </div>
                        <small class="text-center mt-1 text-[0.65rem] text-gray-500">Fichier backlog : <%= typeof backlogFile !== 'undefined' ? backlogFile : '' %></small>
                    </form>
                </div>
                
                <div class="flex gap-2 flex-wrap">
                    <a href="/patchnotes" class="border border-gray-500 text-gray-400 hover:bg-gray-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">📜 Notes</a>
                    <a href="/suggestions" class="border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">✨ Suggestions</a>
                    <a href="/favorites" class="border border-red-500 text-red-500 hover:bg-red-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">Favoris (<%= typeof favoritesCount !== 'undefined' ? favoritesCount : 0 %>)</a>
                    <a href="/queue" class="border border-green-500 text-green-500 hover:bg-green-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">File (<%= typeof queueCount !== 'undefined' ? queueCount : 0 %>)</a>
                    <a href="/playlists" class="border border-yellow-500 text-yellow-500 hover:bg-yellow-500 hover:text-gray-900 rounded-full px-4 py-1.5 text-sm transition-colors no-underline">Playlists</a>
                    <a href="/history" class="border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">Historique (<%= typeof historyCount !== 'undefined' ? historyCount : 0 %>/<%= typeof historyLimit !== 'undefined' ? historyLimit : 0 %>)</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 max-w-[1600px]">
        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Lecteur Vidéo et Infos -->
            <div class="lg:w-2/3 xl:w-3/4">
                <div class="plyr__video-embed rounded-xl overflow-hidden shadow-2xl mb-4 bg-black" id="player">
                    <video id="videoPlayer" controls crossorigin playsinline>
                        <source src="/video/?id=<%= encodeURIComponent(code) %>" type="video/mp4" />
                    </video>
                </div>

                <h1 class="text-2xl md:text-3xl font-bold mb-3"><%= (typeof videodata !== 'undefined' && videodata.title) ? videodata.title : title %></h1>
                
                <div class="flex flex-col md:flex-row md:items-center justify-between mb-4 gap-4 border-b border-gray-800 pb-4">
                    <div class="flex items-center text-gray-300">
                        <img src="/channel-logo/<%= (typeof videodata !== 'undefined' && videodata.uploader) ? encodeURIComponent(videodata.uploader) : '' %>" alt="Logo" class="w-10 h-10 rounded-full object-cover border border-gray-700 mr-3">
                        <div class="flex flex-col">
                            <strong><a href="/channel?name=<%= (typeof videodata !== 'undefined' && videodata.uploader) ? encodeURIComponent(videodata.uploader) : '' %>" class="text-white hover:text-blue-400 no-underline text-lg"><%= (typeof videodata !== 'undefined' && videodata.uploader) ? videodata.uploader : 'Uploader inconnu' %></a></strong>
                            <span class="text-sm text-gray-500"><%= (typeof videodata !== 'undefined' && videodata.view_count) ? videodata.view_count.toLocaleString() + ' vues' : '' %></span>
                        </div>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2">
                        <button id="favoriteBtn" class="border <%= isFavorite ? 'bg-red-600 border-red-600 text-white' : 'border-red-500 text-red-500 hover:bg-red-500 hover:text-white' %> rounded px-3 py-1.5 text-sm transition-colors flex items-center" onclick="toggleFavorite(<%- JSON.stringify(code).replace(/\"/g, '&quot;') %>)">
                            <span class="mr-1"><%= isFavorite ? '❤' : '♡' %></span> Favori
                        </button>
                        <button class="border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-white rounded px-3 py-1.5 text-sm transition-colors" onclick="shareVideo(<%- JSON.stringify((typeof videodata !== 'undefined' && videodata.webpage_url) ? videodata.webpage_url : ('https://www.youtube.com/watch?v=' + code)).replace(/\"/g, '&quot;') %>)">
                            ↗ Partager
                        </button>
                        <button class="border border-green-500 text-green-500 hover:bg-green-500 hover:text-white rounded px-3 py-1.5 text-sm transition-colors" onclick='addToQueue(<%- JSON.stringify(code) %>)'>File d'attente</button>
                        
                        <% if (typeof videodata !== 'undefined' && videodata.uploader && videodata.uploader !== 'Uploader inconnu') { %>
                            <a href="/channel?name=<%= encodeURIComponent(videodata.uploader) %>" class="border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-white rounded px-3 py-1.5 text-sm transition-colors no-underline inline-block">
                                📺 Voir la chaîne
                            </a>
                        <% } %>
                        
                        <% 
                        let targetChannelUrl = null;
                        if (typeof videodata !== 'undefined') {
                            if (typeof videodata.channel_url === 'string' && videodata.channel_url.startsWith('http')) {
                                targetChannelUrl = videodata.channel_url;
                            } else if (typeof videodata.uploader_url === 'string' && videodata.uploader_url.startsWith('http')) {
                                targetChannelUrl = videodata.uploader_url;
                            }
                        }
                        if (targetChannelUrl) { %>
                            <button class="border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded px-3 py-1.5 text-sm transition-colors" onclick="downloadChannel(<%- JSON.stringify(targetChannelUrl) %>)">
                                📥 Télécharger la chaîne
                            </button>
                        <% } %>

                        <!-- Simple Dropdown implementation with Tailwind -->
                        <div class="relative inline-block text-left group">
                            <button type="button" class="border border-yellow-500 text-yellow-500 hover:bg-yellow-500 hover:text-gray-900 rounded px-3 py-1.5 text-sm transition-colors flex items-center">
                                Ajouter à une playlist <span class="ml-1 opacity-70">▼</span>
                            </button>
                            <div class="origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-gray-800 ring-1 ring-black ring-opacity-5 divide-y divide-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
                                <div class="py-1">
                                    <% playlists.forEach(function(playlist) { %>
                                        <form action="/playlist/add" method="POST">
                                            <input type="hidden" name="playlistName" value="<%= playlist.name %>">
                                            <input type="hidden" name="videoId" value="<%= code %>">
                                            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white">
                                                <%= playlist.name %>
                                            </button>
                                        </form>
                                    <% }); %>
                                    <% if (playlists.length === 0) { %>
                                        <span class="block px-4 py-2 text-sm text-gray-500 italic">Aucune playlist</span>
                                    <% } %>
                                </div>
                                <div class="py-1">
                                    <a href="/playlists" class="block px-4 py-2 text-sm text-blue-400 hover:bg-gray-700 hover:text-blue-300">Gérer les playlists</a>
                                </div>
                            </div>
                        </div>

                        <% if (typeof nextVideo !== 'undefined' && nextVideo) { %>
                            <button onclick="playNext()" class="border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded px-3 py-1.5 text-sm transition-colors">Vidéo suivante</button>
                        <% } %>
                        <a href="/delete?id=<%= encodeURIComponent(code) %>" class="border border-red-600 text-red-600 hover:bg-red-600 hover:text-white rounded px-3 py-1.5 text-sm transition-colors no-underline">Supprimer</a>
                    </div>
                </div>

                <div class="bg-gray-800/50 rounded-xl p-4 border border-gray-700/50 mt-4 mb-6">
                    <p class="whitespace-pre-wrap text-sm text-gray-300 m-0"><%= (typeof videodata !== 'undefined') ? videodata.description : '' %></p>
                </div>

                <div class="bg-gray-800 rounded-xl p-4 border border-gray-700 mb-6">
                    <h5 class="text-lg font-medium mb-3">Ajouter un tag</h5>
                    <form action="/tag" method="post" class="flex flex-wrap gap-2">
                        <input type="text" class="flex-grow bg-gray-900 text-white border border-gray-600 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 max-w-xs" id="tagInput" name="tag" placeholder="Tag..." required>
                        <input type="hidden" name="videoId" value="<%= encodeURIComponent(code) %>">
                        <button type="submit" class="bg-gray-700 hover:bg-gray-600 text-white border border-gray-600 rounded px-4 py-1.5 text-sm transition-colors">Taguer</button>
                    </form>
                </div>
            </div>

            <!-- Barre Latérale (Suggestions) -->
            <div class="lg:w-1/3 xl:w-1/4 flex flex-col gap-6">
                <div>
                    <h5 class="text-lg font-medium mb-3">Vidéos suggérées</h5>
                    <div class="flex flex-col gap-3">
                    <% 
                        let suggestions = [];
                        if (typeof nextVideo !== 'undefined' && nextVideo) {
                            suggestions.push(nextVideo);
                        }

                        const otherVideos = videos
                            .filter(v => v.yid !== code && (!nextVideo || v.yid !== (nextVideo.id || nextVideo.yid)))
                            .sort(() => Math.random() - 0.5);
                        
                        suggestions = suggestions.concat(otherVideos).slice(0, 5);

                        suggestions.forEach(function(v) { 
                    %>
                        <div class="flex items-center justify-between gap-2 group">
                            <a class="flex flex-1 min-w-0 text-white no-underline hover:bg-gray-800/50 p-1.5 rounded-lg transition-colors" href="/watch?id=<%= v.yid %>">
                                <div class="w-32 h-20 flex-shrink-0 bg-gray-800 rounded overflow-hidden mr-3">
                                    <img src="/thumbnail/<%= v.yid %>" loading="lazy" class="w-full h-full object-cover" alt="<%= v.fileName %>">
                                </div>
                                <div class="flex flex-col min-w-0 py-0.5 justify-between">
                                    <span class="text-sm font-medium line-clamp-2 leading-snug" title="<%= v.fileName %>"><%= v.fileName %></span>
                                    <span class="text-xs text-gray-400 flex items-center gap-1.5 mt-1">
                                        <% if (v.uploader) { %>
                                            <img src="/channel-logo/<%= encodeURIComponent(v.uploader) %>" alt="Logo" class="w-4 h-4 rounded-full object-cover border border-white/20">
                                            <span class="truncate"><%= v.uploader %></span>
                                        <% } else { %>
                                            Bibliothèque
                                        <% } %>
                                    </span>
                                </div>
                            </a>
                            <button onclick="addToQueue('<%= v.yid %>')" class="flex-shrink-0 border border-green-500 text-green-500 hover:bg-green-500 hover:text-white rounded w-8 h-8 flex items-center justify-center transition-colors opacity-0 group-hover:opacity-100" title="Ajouter à la file">
                                +
                            </button>
                        </div>
                    <% }); %>
                    </div>
                </div>
                
                <div class="pt-4 border-t border-gray-800" id="relatedYoutubeContainer">
                    <h5 class="text-lg font-medium mb-3">Vidéos similaires (YouTube)</h5>
                    <div id="relatedYoutubeLoading" class="text-center py-4">
                        <div class="inline-block animate-spin w-5 h-5 border-2 border-blue-500 border-t-transparent rounded-full" role="status"></div>
                        <span class="ml-2 text-gray-500 text-sm">Recherche sur YouTube...</span>
                    </div>
                    <div id="relatedYoutubeList" class="flex flex-col gap-3"></div>
                </div>
                
                <div class="pt-4 border-t border-gray-800" id="remixesYoutubeContainer">
                    <h5 class="text-lg font-medium mb-3">Remixes (YouTube)</h5>
                    <div id="remixesYoutubeLoading" class="text-center py-4">
                        <div class="inline-block animate-spin w-5 h-5 border-2 border-blue-500 border-t-transparent rounded-full" role="status"></div>
                        <span class="ml-2 text-gray-500 text-sm">Recherche de remixes...</span>
                    </div>
                    <div id="remixesYoutubeList" class="flex flex-col gap-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Plyr JS -->
    <script src="/plyr.polyfilled.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const videoId = <%- JSON.stringify(code) %>;
            const positionKey = `video_pos_${videoId}`;
            const lastUrlKey = 'last_visited_url';
            const sessionNavKey = 'has_navigated_this_session';
            
            // Sauvegarder l'URL actuelle et marquer la session
            localStorage.setItem(lastUrlKey, window.location.href);
            sessionStorage.setItem(sessionNavKey, 'true');

            const player = new Plyr('#videoPlayer', {
                autoplay: true,
                invertTime: false,
                toggleInvert: true,
                keyboard: { focused: true, global: true },
            });

            // Reprendre à la position sauvegardée
            player.on('ready', () => {
                const savedPosition = localStorage.getItem(positionKey);
                if (savedPosition) {
                    player.currentTime = parseFloat(savedPosition);
                }
            });

            // Sauvegarder la position
            player.on('timeupdate', () => {
                if (player.currentTime > 0) {
                    localStorage.setItem(positionKey, player.currentTime);
                }
            });

            // Raccourcis clavier YouTube
            document.addEventListener('keydown', (e) => {
                // Ne pas déclencher si on est dans un input
                if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

                const key = e.key.toLowerCase();
                
                switch(key) {
                    case 'k':
                    case ' ':
                        e.preventDefault();
                        player.togglePlay();
                        break;
                    case 'f':
                        e.preventDefault();
                        player.fullscreen.toggle();
                        break;
                    case 'm':
                        e.preventDefault();
                        player.muted = !player.muted;
                        break;
                    case 'j':
                        e.preventDefault();
                        player.rewind(10);
                        break;
                    case 'l':
                        e.preventDefault();
                        player.forward(10);
                        break;
                    case 'arrowleft':
                        e.preventDefault();
                        player.rewind(5);
                        break;
                    case 'arrowright':
                        e.preventDefault();
                        player.forward(5);
                        break;
                    case 'arrowup':
                        e.preventDefault();
                        player.volume += 0.05;
                        break;
                    case 'arrowdown':
                        e.preventDefault();
                        player.volume -= 0.05;
                        break;
                    case 'n':
                        if (e.shiftKey) { // YouTube shortcut: Shift + N
                            e.preventDefault();
                            playNext();
                        }
                        break;
                }

                // Touches 0-9 pour le pourcentage
                if (/^[0-9]$/.test(key)) {
                    e.preventDefault();
                    const percentage = parseInt(key) * 10;
                    player.currentTime = player.duration * (percentage / 100);
                }
            });

            // Autoplay next video
            document.getElementById('videoPlayer').addEventListener('ended', function() {
                playNext();
            });

            function escapeHTML(str) {
                if (!str) return '';
                return str.replace(/[&<>'"]/g, 
                    tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
                );
            }

            function createYoutubeSuggestionCard(v) {
                let thumbUrl = `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`;
                if (v.thumbnails && v.thumbnails.length > 0) {
                    thumbUrl = v.thumbnails[v.thumbnails.length - 1].url;
                }
                let durStr = '';
                if (v.duration) {
                    const min = Math.floor(v.duration / 60);
                    const sec = Math.floor(v.duration % 60);
                    durStr = `${min}:${sec < 10 ? '0' : ''}${sec}`;
                }
                
                const card = document.createElement('div');
                card.className = 'flex items-center justify-between gap-2 group';
                card.innerHTML = `
                    <a class="flex flex-1 min-w-0 text-white no-underline hover:bg-gray-800/50 p-1.5 rounded-lg transition-colors cursor-pointer" href="/watch?id=${encodeURIComponent(v.id)}">
                        <div class="relative w-32 h-20 flex-shrink-0 bg-gray-900 rounded overflow-hidden mr-3">
                            <img src="${thumbUrl}" class="w-full h-full object-cover" alt="${escapeHTML(v.title)}">
                            ${durStr ? `<span class="absolute bottom-1 right-1 bg-black/80 text-white px-1 py-0.5 rounded text-[0.65rem]">${durStr}</span>` : ''}
                        </div>
                        <div class="flex flex-col min-w-0 justify-between py-0.5">
                            <span class="text-sm font-medium line-clamp-2 leading-snug" title="${escapeHTML(v.title)}">${escapeHTML(v.title)}</span>
                            <span class="text-xs text-gray-400 flex items-center gap-1.5 mt-1">
                                <img src="/channel-logo/${encodeURIComponent(v.uploader || v.channel || 'YouTube')}" alt="Logo" class="w-4 h-4 rounded-full object-cover border border-white/20">
                                <span class="truncate">${escapeHTML(v.uploader || v.channel || 'YouTube')}</span>
                            </span>
                        </div>
                    </a>
                    <button class="flex-shrink-0 border border-green-500 text-green-500 hover:bg-green-500 hover:text-white rounded w-8 h-8 flex items-center justify-center transition-colors opacity-0 group-hover:opacity-100" title="Télécharger">
                        📥
                    </button>
                `;
                
                const downloadBtn = card.querySelector('button');
                downloadBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    downloadYoutubeVideo(v.id);
                });
                
                return card;
            }

            // Charger les vidéos similaires de YouTube de manière asynchrone
            const videoTitle = <%- JSON.stringify(typeof videodata !== 'undefined' && videodata.title ? videodata.title : '') %>;
            const videoUploader = <%- JSON.stringify(typeof videodata !== 'undefined' && videodata.uploader ? videodata.uploader : '') %>;
            if (videoTitle) {
                fetch(`/api/related?title=${encodeURIComponent(videoTitle)}&uploader=${encodeURIComponent(videoUploader)}`)
                    .then(r => r.json())
                    .then(data => {
                        const loader = document.getElementById('relatedYoutubeLoading');
                        const list = document.getElementById('relatedYoutubeList');
                        if (loader) loader.style.display = 'none';
                        if (!list) return;

                        if (data && data.length > 0) {
                            data.forEach(v => {
                                list.appendChild(createYoutubeSuggestionCard(v));
                            });
                        } else {
                            list.innerHTML = '<div class="text-center text-gray-500 py-2 text-sm">Aucune vidéo similaire trouvée.</div>';
                        }
                    })
                    .catch(err => {
                        console.error("Erreur chargement vidéos similaires:", err);
                        const loader = document.getElementById('relatedYoutubeLoading');
                        if (loader) loader.innerHTML = '<span class="text-red-500 text-sm">Erreur de chargement</span>';
                    });

                // Charger les remixes de YouTube de manière asynchrone
                fetch(`/api/remixes?title=${encodeURIComponent(videoTitle)}`)
                    .then(r => r.json())
                    .then(data => {
                        const loader = document.getElementById('remixesYoutubeLoading');
                        const list = document.getElementById('remixesYoutubeList');
                        if (loader) loader.style.display = 'none';
                        if (!list) return;

                        if (data && data.length > 0) {
                            data.forEach(v => {
                                list.appendChild(createYoutubeSuggestionCard(v));
                            });
                        } else {
                            list.innerHTML = '<div class="text-center text-gray-500 py-2 text-sm">Aucun remix trouvé.</div>';
                        }
                    })
                    .catch(err => {
                        console.error("Erreur chargement remixes:", err);
                        const loader = document.getElementById('remixesYoutubeLoading');
                        if (loader) loader.innerHTML = '<span class="text-red-500 text-sm">Erreur de chargement</span>';
                    });
            }

            // Exposé pour le debug si besoin
            window.player = player;
        });

        async function playNext() {
            const nextId = '<%= (typeof nextVideo !== "undefined" && nextVideo) ? (nextVideo.id || nextVideo.yid) : "" %>';
            const playlistParam = '<%= (typeof playlistName !== 'undefined' && playlistName) ? "&playlist=" + encodeURIComponent(playlistName).replace(/'/g, "%27") : "" %>';
            const currentInQueue = <%= typeof currentInQueue !== 'undefined' ? currentInQueue : 'false' %>;
            
            if (currentInQueue) {
                try {
                    await fetch(`/queue/remove?id=<%= encodeURIComponent(code) %>`, { headers: { 'Accept': 'application/json' } });
                } catch(e) {
                    console.error("Erreur suppression file :", e);
                }
            }

            if (nextId) {
                window.location.href = `/watch?id=${nextId}${playlistParam}`;
            } else if (currentInQueue) {
                // Si on était dans la file et qu'il n'y a pas de vidéo suivante, on retourne à l'accueil
                window.location.href = '/';
            }
        }

        async function shareVideo(url) {
            try {
                await navigator.clipboard.writeText(url);
                const shareBtn = document.activeElement;
                const originalText = shareBtn.innerHTML;
                shareBtn.innerHTML = '✓ Copié !';
                shareBtn.classList.replace('border-cyan-500', 'border-cyan-400');
                shareBtn.classList.replace('text-cyan-500', 'bg-cyan-500');
                shareBtn.classList.add('text-white');
                setTimeout(() => {
                    shareBtn.innerHTML = originalText;
                    shareBtn.classList.replace('border-cyan-400', 'border-cyan-500');
                    shareBtn.classList.replace('bg-cyan-500', 'text-cyan-500');
                    shareBtn.classList.remove('text-white');
                }, 2000);
            } catch (err) {
                alert("Lien YouTube : " + url);
            }
        }

        function downloadYoutubeVideo(id) {
            const url = `https://www.youtube.com/watch?v=${id}`;
            if (window.electronAPI && window.electronAPI.setTitle) {
                window.electronAPI.setTitle(url);
                showToast('Téléchargement', 'Téléchargement lancé avec succès !', 'primary');
            } else {
                window.location.href = `/download?url=${encodeURIComponent(url)}`;
            }
        }

        // Le téléchargement est géré par renderer.js via IPC.
        // On peut ajouter un fallback au cas où renderer.js ne se charge pas correctement.
        const commandForm = document.getElementById('commandForm');
        commandForm.addEventListener('submit', (e) => {
            // Si window.electronAPI n'existe pas, on utilise la route Express classique
            if (!window.electronAPI) {
                e.preventDefault();
                const url = document.getElementById('commandInput').value;
                window.location.href = `/download?url=${encodeURIComponent(url)}`;
            }
        });
    </script>
</body>
</html>
