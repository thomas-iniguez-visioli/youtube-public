<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chaînes suivies - YouTube Downloader</title>
    
    <!-- Tailwind CSS -->
    <link href="/tailwind.css" rel="stylesheet">
    <!-- Roboto Font -->
    <link href="/roboto.css" rel="stylesheet">
    
    <script src="/fuse.js"></script>
    <script src="socket.io.js"></script>
    <script src="renderer.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <!-- Toast Container -->
    <div class="fixed bottom-0 right-0 p-3 z-50 flex flex-col gap-2"></div>

    <nav class="sticky top-0 bg-gray-900/95 backdrop-blur-sm border-b border-gray-800 z-40 mb-4">
        <div class="container mx-auto px-4 py-2">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <a class="flex items-center no-underline text-white" href="/">
                    <img src="/favicon.ico" width="30" height="30" class="mr-2" alt="">
                    <strong class="text-lg">YouTube Downloader</strong>
                </a>
                <div class="flex ml-auto gap-2 flex-wrap">
                    <a href="/" class="border border-gray-500 text-gray-400 hover:bg-gray-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">🏠 Accueil</a>
                    <a href="/suggestions" class="border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">✨ Suggestions</a>
                    <a href="/followed-channels" class="bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-medium rounded-full px-4 py-1.5 text-sm transition-colors no-underline">📺 Suivis</a>
                    <a href="/favorites" class="border border-red-500 text-red-500 hover:bg-red-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">Favoris (<%= typeof favoritesCount !== 'undefined' ? favoritesCount : 0 %>)</a>
                    <a href="/queue" class="border border-green-500 text-green-500 hover:bg-green-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">File (<%= typeof queueCount !== 'undefined' ? queueCount : 0 %>)</a>
                    <a href="/history" class="border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-white rounded-full px-4 py-1.5 text-sm transition-colors no-underline">Historique</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 mt-4">
        <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
            <h2 class="text-white text-2xl font-bold mb-0">📺 Chaînes suivies</h2>
            <div class="flex gap-2">
                <button id="syncAllBtn" class="border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-white rounded-full px-4 py-2 transition-colors flex items-center font-medium">
                    🔄 Vérifier maintenant
                </button>
            </div>
        </div>

        <!-- Barre de progression de la vérification -->
        <div id="syncProgressBar" class="mb-6" style="display:none;">
            <div class="bg-gray-800 border border-gray-700 rounded-lg p-4 shadow-lg">
                <div class="flex justify-between items-center mb-2">
                    <span id="syncProgressLabel" class="text-white text-sm font-medium">Vérification en cours...</span>
                    <span id="syncProgressCount" class="text-gray-400 text-xs">0 / 0</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-1.5 overflow-hidden">
                    <div id="syncProgressFill" class="bg-gradient-to-r from-blue-500 to-purple-500 h-1.5 rounded-full transition-all duration-300" style="width:0%"></div>
                </div>
            </div>
        </div>

        <% if (followedChannels.length === 0) { %>
            <div class="text-center py-12 bg-gray-800/50 rounded-xl border border-gray-700">
                <p class="text-gray-400 text-lg mb-2">Vous ne suivez aucune chaîne pour l'instant.</p>
                <p class="text-gray-500 text-sm mb-6">Rendez-vous sur la page d'une chaîne et cliquez sur <strong class="text-white">➕ Suivre cette chaîne</strong>.</p>
                <a href="/" class="inline-block border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded-full px-8 py-2 transition-colors font-medium">Explorer ma bibliothèque</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4" id="channelsList">
                <% followedChannels.forEach(function(ch) { %>
                    <div id="channel-card-<%= encodeURIComponent(ch.name) %>" class="flex">
                        <div class="bg-gray-800 border border-gray-700 rounded-xl overflow-hidden flex flex-col w-full h-full transition-transform hover:-translate-y-1 hover:shadow-lg">
                            <!-- Miniature de la dernière vidéo -->
                            <div class="relative h-28 bg-gray-900 overflow-hidden">
                                <% if (ch.lastVideo) { %>
                                    <img src="/thumbnail/<%= ch.lastVideo.yid %>"
                                         alt="Dernière vidéo"
                                         class="w-full h-full object-cover opacity-65 hover:opacity-80 transition-opacity">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-4xl">📺</div>
                                <% } %>
                                <img src="/channel-logo/<%= encodeURIComponent(ch.name) %>"
                                     alt="Logo"
                                     class="absolute bottom-2 left-2 w-10 h-10 rounded-full object-cover border-2 border-white/30 shadow-md">
                            </div>

                            <div class="p-3 flex flex-col gap-2 flex-grow">
                                <a href="/channel?name=<%= encodeURIComponent(ch.name) %>"
                                   class="text-white font-semibold text-sm truncate hover:text-blue-400 transition-colors"
                                   title="<%= ch.name %>">
                                    <%= ch.name %>
                                </a>

                                <div class="flex flex-wrap gap-1">
                                    <span class="bg-white/10 border border-white/10 text-gray-300 text-[0.65rem] px-2 py-0.5 rounded-md">
                                        <%= ch.videoCount %> vidéo<%= ch.videoCount > 1 ? 's' : '' %>
                                    </span>
                                    <% if (ch.lastCheckedAt) { %>
                                        <span class="bg-blue-500/15 border border-blue-500/30 text-blue-300 text-[0.65rem] px-2 py-0.5 rounded-md" title="Dernière vérification">
                                            🕐 <%= new Date(ch.lastCheckedAt).toLocaleDateString('fr-FR') %>
                                        </span>
                                    <% } else { %>
                                        <span class="bg-white/5 border border-white/10 text-gray-500 text-[0.65rem] px-2 py-0.5 rounded-md">
                                            Pas encore vérifié
                                        </span>
                                    <% } %>
                                    <% if (ch.lastNewVideoAt) { %>
                                        <span class="bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[0.65rem] px-2 py-0.5 rounded-md" title="Dernière nouvelle vidéo">
                                            🆕 <%= new Date(ch.lastNewVideoAt).toLocaleDateString('fr-FR') %>
                                        </span>
                                    <% } %>
                                </div>

                                <div class="flex gap-2 mt-auto pt-2 border-t border-gray-700/50">
                                    <a href="/channel?name=<%= encodeURIComponent(ch.name) %>"
                                       class="flex-grow border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white rounded py-1 text-center text-xs transition-colors">
                                        Voir les vidéos
                                    </a>
                                    <button class="border border-red-500 text-red-500 hover:bg-red-500 hover:text-white rounded px-2 py-1 text-xs transition-colors flex items-center justify-center"
                                            onclick="unfollowChannel(<%- JSON.stringify(ch.name) %>, this)"
                                            title="Ne plus suivre">
                                        ✕
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <script>
        async function unfollowChannel(channelName, btn) {
            if (!confirm(`Ne plus suivre "${channelName}" ?`)) return;
            btn.disabled = true;
            try {
                const res = await fetch('/channel/unfollow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: channelName })
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById('channel-card-' + encodeURIComponent(channelName));
                    if (card) card.remove();
                    showToast('Chaîne retirée', `Vous ne suivez plus "${channelName}".`, 'primary');
                    // Si plus aucune carte, afficher le message vide
                    const list = document.getElementById('channelsList');
                    if (list && list.children.length === 0) {
                        list.innerHTML = '<div class="col-span-full text-center py-12 bg-gray-800/50 rounded-xl border border-gray-700"><p class="text-gray-400 text-lg">Vous ne suivez aucune chaîne.</p></div>';
                    }
                }
            } catch (e) {
                console.error(e);
                showToast('Erreur', 'Impossible de retirer la chaîne.', 'error');
                btn.disabled = false;
            }
        }

        // Bouton "Vérifier maintenant"
        document.getElementById('syncAllBtn').addEventListener('click', function() {
            this.disabled = true;
            this.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white/20 border-t-white rounded-full mr-2"></span> Vérification...';
            fetch('/maintenance/check-channels')
                .then(r => r.json())
                .then(data => {
                    showToast('Sync', data.message || 'Vérification lancée.', 'success');
                })
                .catch(err => {
                    showToast('Erreur', 'Impossible de lancer la vérification.', 'error');
                    this.disabled = false;
                    this.innerHTML = '🔄 Vérifier maintenant';
                });
        });

        // Socket.io : progression de la vérification
        if (typeof io !== 'undefined') {
            const _sock = typeof socket !== 'undefined' ? socket : io();
            const progressBar = document.getElementById('syncProgressBar');
            const progressLabel = document.getElementById('syncProgressLabel');
            const progressCount = document.getElementById('syncProgressCount');
            const progressFill = document.getElementById('syncProgressFill');
            const syncBtn = document.getElementById('syncAllBtn');

            _sock.on('channel-check-started', data => {
                progressBar.style.display = 'block';
                progressLabel.textContent = 'Démarrage de la vérification...';
                progressCount.textContent = `0 / ${data.total}`;
                progressFill.style.width = '0%';
            });

            _sock.on('channel-check-progress', data => {
                const pct = Math.round((data.current / data.total) * 100);
                progressLabel.textContent = `Vérification de : ${data.channelName}`;
                progressCount.textContent = `${data.current} / ${data.total}`;
                progressFill.style.width = pct + '%';
            });

            _sock.on('channel-new-videos', data => {
                showToast('Nouvelles vidéos', `${data.count} nouvelle(s) vidéo(s) de <strong>${data.channelName}</strong> ajoutée(s).`, 'primary');
            });

            _sock.on('channel-check-error', data => {
                showToast('Erreur', `Échec pour ${data.channelName} : ${data.error}`, 'error');
            });

            _sock.on('channel-check-finished', data => {
                progressFill.style.width = '100%';
                progressLabel.textContent = 'Vérification terminée !';
                progressCount.textContent = `${data.total} / ${data.total}`;
                syncBtn.disabled = false;
                syncBtn.innerHTML = '🔄 Vérifier maintenant';
                setTimeout(() => { progressBar.style.display = 'none'; }, 3000);
                if (data.totalAdded > 0) {
                    showToast('Sync terminée', `${data.totalAdded} nouvelle(s) vidéo(s) ajoutée(s) au téléchargement.`, 'success');
                    // Recharger la page pour mettre à jour les dates de dernière vérification
                    setTimeout(() => window.location.reload(), 2000);
                } else {
                    showToast('Sync terminée', 'Aucune nouvelle vidéo trouvée.', 'primary');
                }
            });
        }
    </script>
</body>
</html>
