<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YouTube Downloader - Ma Bibliothèque</title>
    
    <link href="/tailwind.css" rel="stylesheet">
    <link rel="stylesheet" href="/plyr.css" />
    <script src="/fuse.js"></script>
    <link href="/roboto.css" rel="stylesheet">

    <script src="socket.io.js"></script>
    <script src="renderer.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-[#050505] text-neutral-100 min-h-screen font-sans" style="background-image: radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.08), transparent 25%), radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.08), transparent 25%); background-attachment: fixed;">
    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[1060] flex flex-col gap-2 max-w-sm w-full px-4 pointer-events-none"></div>

    <nav class="navbar sticky top-0 z-50 flex flex-wrap items-center justify-between gap-4">
        <a class="flex items-center gap-2 text-white font-bold" href="/">
            <img src="/favicon.ico" width="30" height="30" alt="">
            <div class="flex flex-col">
                <strong>YouTube Downloader</strong>
                <span class="text-[10px] text-neutral-400 -mt-1">v<%= typeof appVersion !== 'undefined' ? appVersion : '' %></span>
            </div>
        </a>
        
        <div class="flex-1 max-w-xl mx-4">
            <form id="commandForm" class="flex flex-col m-0 w-full">
                <div class="flex items-center gap-2">
                    <input class="form-control text-white rounded-full px-4 py-2 text-sm w-full focus:outline-none transition" type="text" id="commandInput" placeholder="Coller une URL YouTube..." required>
                    <button class="btn btn-outline-primary text-white rounded-full px-4 py-2 text-sm font-semibold transition" type="submit">Télécharger</button>
                    <button type="button" class="btn btn-outline-secondary rounded-full p-2 text-sm transition" title="Changer le dossier de téléchargement" onclick="changeFolder()">📂</button>
                </div>
                <small class="text-[10px] text-neutral-500 text-center mt-1">Fichier backlog : <%= typeof backlogFile !== 'undefined' ? backlogFile : '' %></small>
            </form>
        </div>

        <div class="flex items-center gap-2 flex-wrap text-sm">
            <a href="https://github.com/sponsors/alphaleadership" target="_blank" class="btn btn-outline-danger rounded-full px-4 py-1.5 font-medium transition">💖 Sponsor</a>
            <a href="/patchnotes" class="btn btn-outline-secondary rounded-full px-4 py-1.5 font-medium transition">📜 Notes</a>
            <a href="/suggestions" class="btn btn-outline-primary rounded-full px-4 py-1.5 font-medium transition">✨ Suggestions</a>
            <a href="/followed-channels" class="btn btn-outline-warning rounded-full px-4 py-1.5 font-medium transition">📺 Suivis</a>
            <a href="/favorites" class="btn btn-outline-danger rounded-full px-4 py-1.5 font-medium transition">Favoris (<%= typeof favoritesCount !== 'undefined' ? favoritesCount : 0 %>)</a>
            <a href="/queue" class="btn btn-outline-success rounded-full px-4 py-1.5 font-medium transition">File (<%= typeof queueCount !== 'undefined' ? queueCount : 0 %>)</a>
            <a href="/playlists" class="btn btn-outline-warning rounded-full px-4 py-1.5 font-medium transition">Playlists</a>
            <a href="/history" class="btn btn-outline-info rounded-full px-4 py-1.5 font-medium transition">Historique (<%= typeof historyCount !== 'undefined' ? historyCount : 0 %>/<%= typeof historyLimit !== 'undefined' ? historyLimit : 0 %>)</a>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 mt-6">
        <div class="max-w-xl mx-auto mb-6">
            <input type="text" id="fuzzySearchInput" class="bg-neutral-900 border border-neutral-800 text-white rounded-full px-5 py-2 text-sm w-full focus:outline-none focus:border-blue-500 transition" placeholder="🔍 Rechercher dans votre bibliothèque (titre, uploader...)" autocomplete="off">
        </div>
        
        <% if (typeof channel !== 'undefined' && channel) { %>
            <div class="flex items-center gap-3 mb-6 mt-4 flex-wrap">
                <h2 class="text-xl font-bold text-white"><%= channel %></h2>
                <% if (typeof channelUrl === 'string' && channelUrl.startsWith('http')) { %>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white rounded-full px-3 py-1 text-xs font-semibold transition" onclick="downloadChannel(<%- JSON.stringify(channelUrl).replace(/\"/g, '&quot;') %>)">Télécharger la chaîne</button>
                <% } %>
                <% if (channel !== "Ma File d'attente" && channel !== "Mes Playlists" && channel !== "Mes Favoris" && channel !== "Historique" && !channel.startsWith('Playlist : ')) { %>
                    <button class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-full px-3 py-1 text-xs font-semibold transition" onclick="addAllToQueue()">Ajouter tout à la file</button>
                    <% if (typeof channelUrl === 'string' && channelUrl.startsWith('http')) { %>
                        <% if (typeof isFollowed !== 'undefined' && isFollowed) { %>
                            <button id="followBtn" class="bg-yellow-500 hover:bg-yellow-600 text-neutral-900 rounded-full px-3 py-1 text-xs font-semibold transition" onclick="toggleFollowChannel(<%- JSON.stringify(channel) %>, <%- JSON.stringify(channelUrl) %>, this)">
                                ✅ Suivi
                            </button>
                        <% } else { %>
                            <button id="followBtn" class="border border-yellow-550/50 hover:bg-yellow-500/10 text-yellow-400 rounded-full px-3 py-1 text-xs font-semibold transition" onclick="toggleFollowChannel(<%- JSON.stringify(channel) %>, <%- JSON.stringify(channelUrl) %>, this)">
                                ➕ Suivre cette chaîne
                            </button>
                        <% } %>
                    <% } %>
                <% } %>
                <% if (channel.startsWith('Playlist : ')) { %>
                    <a href="/playlist/delete?name=<%= encodeURIComponent(channel.replace('Playlist : ', '')) %>" class="bg-red-655 hover:bg-red-700 text-white rounded-full px-3 py-1 text-xs font-semibold transition" onclick="return confirm('Supprimer cette playlist ?')">Supprimer la playlist</a>
                <% } %>
                <% if (channel === "Ma File d'attente") { %>
                    <a href="/queue/clear" class="bg-red-655 hover:bg-red-700 text-white rounded-full px-3 py-1 text-xs font-semibold transition" onclick="return confirm('Vider la file d\'attente ?')">Vider la file</a>
                <% } %>
                <% if (channel === "Historique") { %>
                    <a href="/history/clear" class="bg-red-655 hover:bg-red-700 text-white rounded-full px-3 py-1 text-xs font-semibold transition" onclick="return confirm('Purger l\'historique ?')">Purger l'historique</a>
                <% } %>
                <a href="/" class="border border-neutral-700 hover:bg-neutral-800 text-neutral-300 rounded-full px-3 py-1 text-xs font-semibold transition">Retour à l'accueil</a>
            </div>
        <% } %>

        <% if (typeof channel === 'undefined' || !channel || channel === "Mes Playlists") { %>
            <div class="flex justify-center border-b border-neutral-800 mt-4 mb-6" id="mainTab">
                <button class="px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 <%= (typeof channel === 'undefined' || !channel) ? 'border-blue-500 text-blue-400' : 'border-transparent text-neutral-400 hover:text-neutral-200' %>" id="videos-tab" onclick="switchTab('videos')">🎥 Vidéos</button>
                <button class="px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 <%= (channel === 'Mes Playlists') ? 'border-blue-500 text-blue-400' : 'border-transparent text-neutral-400 hover:text-neutral-200' %>" id="playlists-tab" onclick="switchTab('playlists')">📁 Playlists</button>
            </div>

            <div>
                <!-- Onglet Vidéos -->
                <div class="<%= (typeof channel === 'undefined' || !channel) ? 'block' : 'hidden' %>" id="videos-pane">
                    <!-- Section Filtres Inline -->
                    <div class="flex gap-2 flex-wrap overflow-x-auto pb-4 mb-4">
                        <div class="bg-blue-600/25 border border-blue-500/40 text-blue-400 hover:bg-blue-600/35 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip active" onclick="filterByTag('all', this)">Tous</div>
                        <div class="bg-neutral-900 border border-neutral-800 hover:bg-neutral-800 text-amber-400 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip" onclick="switchToPlaylistsTab(this)">📁 Playlists</div>
                        <% if (typeof allTags !== 'undefined') { %>
                            <% allTags.forEach(function(tag){ %>
                                <div class="bg-neutral-900 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip" onclick="filterByTag('<%= tag.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>', this)"><%= tag %></div>
                            <% }); %>
                        <% } %>
                        <% if (typeof allChannels !== 'undefined') { %>
                            <% allChannels.forEach(function(uploader){ %>
                                <div class="bg-neutral-900 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip" onclick="filterByChannel('<%= uploader.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>', this)"><%= uploader %></div>
                            <% }); %>
                        <% } %>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6" id="resultsList">
                        <!-- Les vidéos seront chargées ici par JavaScript -->
                    </div>
                    <div class="text-center my-8 hidden" id="loadMoreContainer">
                        <button id="loadMoreBtn" class="border border-blue-500/50 hover:bg-blue-500/10 text-blue-400 rounded-full px-6 py-2.5 font-semibold text-sm transition">Charger plus de vidéos</button>
                    </div>
                </div>

                <!-- Onglet Playlists -->
                <div class="<%= (channel === 'Mes Playlists') ? 'block' : 'hidden' %>" id="playlists-pane">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 flex flex-col justify-between gap-4">
                            <h5 class="font-bold text-white text-sm">Créer une playlist</h5>
                            <form action="/playlist/create" method="POST" class="flex gap-2">
                                <input type="text" name="name" class="bg-neutral-950 border border-neutral-800 text-white rounded-lg px-3 py-2 text-xs w-full focus:outline-none focus:border-blue-500 transition" placeholder="Nom de la playlist" required>
                                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg px-4 py-2 text-xs font-bold transition">Créer</button>
                            </form>
                        </div>
                        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 flex flex-col justify-between gap-4">
                            <h5 class="font-bold text-white text-sm">Maintenance & Mises à jour</h5>
                            <div class="grid grid-cols-2 gap-2">
                                <a href="/cache/clear-logos" class="border border-red-500/30 hover:bg-red-500/10 text-red-400 rounded-lg py-2 text-xs font-semibold text-center transition" onclick="return confirm('Vider le cache des logos de chaînes ?')">🧹 Purger logos</a>
                                <button id="cleanup-btn" class="border border-amber-500/30 hover:bg-amber-500/10 text-amber-400 rounded-lg py-2 text-xs font-semibold transition">🧹 Nettoyer vidéos</button>
                                <button id="sync-channels-btn" class="border border-cyan-555/35 hover:bg-cyan-500/10 text-cyan-400 rounded-lg py-2 text-xs font-semibold transition">🔄 Sync chaînes</button>
                                <button id="check-update-btn" class="border border-blue-500/30 hover:bg-blue-500/10 text-blue-400 rounded-lg py-2 text-xs font-semibold transition">🔄 Chercher MAJ</button>
                            </div>
                        </div>
                    </div>

                    <!-- Section Vos Playlists -->
                    <h4 class="text-lg font-bold text-white mb-4">📁 Vos Playlists</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6 mb-8">
                        <% const realPlaylists = playlists.filter(p => !p.name.startsWith('Channel: ')); %>
                        <% if (realPlaylists.length === 0) { %>
                            <div class="col-span-full text-neutral-500 text-sm">Aucune playlist créée.</div>
                        <% } else { %>
                            <% realPlaylists.forEach(function(playlist) { %>
                                <a href="/playlist?name=<%= encodeURIComponent(playlist.name) %>" class="group">
                                    <div class="bg-neutral-900 border border-neutral-800 group-hover:border-neutral-700 rounded-2xl overflow-hidden transition duration-200">
                                        <div class="h-28 bg-neutral-800 flex flex-col justify-center items-center p-4">
                                            <h5 class="text-sm font-bold text-white text-center truncate w-full" title="<%= playlist.name.replace('Playlist: ', '') %>"><%= playlist.name.replace('Playlist: ', '') %></h5>
                                            <span class="bg-neutral-750 text-neutral-300 text-[10px] px-2.5 py-0.5 rounded-full border border-neutral-700 mt-2"><%= playlist.videoIds.length %> vidéos</span>
                                        </div>
                                    </div>
                                </a>
                            <% }); %>
                        <% } %>
                    </div>

                    <!-- Section Chaînes -->
                    <h4 class="text-lg font-bold text-white mb-4">📺 Chaînes suivies</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6">
                        <% const channelPlaylists = playlists.filter(p => p.name.startsWith('Channel: ')); %>
                        <% if (channelPlaylists.length === 0) { %>
                            <div class="col-span-full text-neutral-500 text-sm">Aucune chaîne suivie.</div>
                        <% } else { %>
                            <% channelPlaylists.forEach(function(playlist) { %>
                                <a href="/playlist?name=<%= encodeURIComponent(playlist.name) %>" class="group">
                                    <div class="bg-neutral-900 border border-neutral-800 group-hover:border-neutral-700 rounded-2xl overflow-hidden transition duration-200">
                                        <div class="relative h-28 bg-neutral-950 overflow-hidden">
                                            <% if (playlist.videoIds.length > 0) { %>
                                                <img src="/thumbnail/<%= playlist.videoIds[0] %>" class="w-full h-full object-cover opacity-60" alt="Logo Chaîne">
                                                <img src="/channel-logo/<%= encodeURIComponent(playlist.name.replace('Channel: ', '')) %>" alt="Logo" class="absolute bottom-2 left-2 w-9 h-9 rounded-full object-cover border border-neutral-750 bg-neutral-900">
                                            <% } else { %>
                                                <div class="h-full flex items-center justify-center text-4xl">📺</div>
                                            <% } %>
                                        </div>
                                        <div class="p-3">
                                            <h6 class="text-white text-xs font-bold truncate mb-1" title="<%= playlist.name.replace('Channel: ', '') %>"><%= playlist.name.replace('Channel: ', '') %></h6>
                                            <span class="bg-neutral-800 text-neutral-450 text-[10px] px-2 py-0.5 rounded border border-neutral-750"><%= playlist.videoIds.length %> vidéos</span>
                                        </div>
                                    </div>
                                </a>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } else { %>
            <!-- Section Filtres Inline -->
            <div class="flex gap-2 flex-wrap overflow-x-auto pb-4 mb-4">
                <div class="bg-blue-600/25 border border-blue-500/40 text-blue-400 hover:bg-blue-600/35 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip active" onclick="filterByTag('all', this)">Tous</div>
                <% if (typeof allTags !== 'undefined') { %>
                    <% allTags.forEach(function(tag){ %>
                        <div class="bg-neutral-900 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip" onclick="filterByTag('<%= tag.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>', this)"><%= tag %></div>
                    <% }); %>
                <% } %>
                <% if (typeof allChannels !== 'undefined') { %>
                    <% allChannels.forEach(function(uploader){ %>
                        <div class="bg-neutral-900 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 rounded-full px-4 py-1.5 text-xs font-semibold cursor-pointer transition filter-chip" onclick="filterByChannel('<%= uploader.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>', this)"><%= uploader %></div>
                    <% }); %>
                <% } %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6" id="resultsList">
                <!-- Les vidéos seront chargées ici par JavaScript -->
            </div>
            <div class="text-center my-8 hidden" id="loadMoreContainer">
                <button id="loadMoreBtn" class="border border-blue-500/50 hover:bg-blue-500/10 text-blue-400 rounded-full px-6 py-2.5 font-semibold text-sm transition">Charger plus de vidéos</button>
            </div>
        <% } %>
    </div>

    <script>
        const allVideos = <%- JSON.stringify(results) %>;
        const channel = <%- JSON.stringify(channel) %>;
        const itemsPerPage = 24;
        let currentPage = 0;
        let filteredVideos = [...allVideos];

        const resultsList = document.getElementById('resultsList');
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        const loadMoreContainer = document.getElementById('loadMoreContainer');
        const searchInput = document.getElementById('fuzzySearchInput');

        function switchTab(tabName) {
            const videosTab = document.getElementById('videos-tab');
            const playlistsTab = document.getElementById('playlists-tab');
            const videosPane = document.getElementById('videos-pane');
            const playlistsPane = document.getElementById('playlists-pane');

            if (!videosTab || !playlistsTab) return;

            if (tabName === 'videos') {
                videosTab.className = 'px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 border-blue-500 text-blue-400';
                playlistsTab.className = 'px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 border-transparent text-neutral-400 hover:text-neutral-255';
                videosPane.classList.remove('hidden');
                playlistsPane.classList.add('hidden');
            } else {
                playlistsTab.className = 'px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 border-blue-500 text-blue-400';
                videosTab.className = 'px-6 py-2 border-b-2 font-semibold text-sm transition-all duration-200 border-transparent text-neutral-400 hover:text-neutral-255';
                playlistsPane.classList.remove('hidden');
                videosPane.classList.add('hidden');
            }
        }

        function switchToPlaylistsTab(elem) {
            switchTab('playlists');
        }

        function renderVideos(append = false) {
            if (!resultsList) return;
            if (!append) {
                resultsList.innerHTML = '';
                currentPage = 0;
            }

            const start = currentPage * itemsPerPage;
            const end = start + itemsPerPage;
            const pageVideos = filteredVideos.slice(start, end);

            pageVideos.forEach(result => {
                let playlistParam = '';
                if (channel) {
                    if (channel.startsWith('Playlist : ')) {
                        playlistParam = '&playlist=' + encodeURIComponent(channel.replace('Playlist : ', '')).replace(/'/g, "%27");
                    } else if (channel !== 'Mes Playlists' && channel !== 'Historique') {
                        playlistParam = '&playlist=' + encodeURIComponent('Channel: ' + channel).replace(/'/g, "%27");
                    }
                }

                const cardDiv = document.createElement('div');
                cardDiv.className = 'video-card video-item';
                cardDiv.setAttribute('data-tags', result.tags.join(','));
                cardDiv.addEventListener('click', () => {
                    location.href = `/watch?id=${result.yid}${playlistParam}`;
                });
                
                let tagsHtml = result.tags.map(tag => `<span class="tag-badge">${tag}</span>`).join('');
                
                let actionBtns = `<div class="flex gap-1 mt-3 w-full flex-wrap" onclick="event.stopPropagation();">`;
                if (channel && channel.startsWith('Playlist : ')) {
                    actionBtns += `<button class="bg-amber-600 hover:bg-amber-700 text-white rounded-lg px-2 py-1 text-[10px] font-bold transition" onclick="if(confirm('Retirer de la playlist ?')) window.location.href='/playlist/remove?name=${encodeURIComponent(channel.replace('Playlist : ', ''))}&videoId=${result.yid}'">Retirer</button>`;
                }
                if (channel === "Ma File d'attente") {
                    actionBtns += `<button class="bg-amber-655 hover:bg-amber-700 text-white rounded-lg px-2 py-1 text-[10px] font-bold transition" onclick="window.location.href='/queue/remove?id=${result.yid}'">Retirer</button>`;
                } else {
                    actionBtns += `<button class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg px-2.5 py-1 text-[10px] font-bold transition" onclick="addToQueue('${result.yid}')">File</button>`;
                }
                actionBtns += `<button class="bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg px-2.5 py-1 text-[10px] font-bold border border-red-500/20 transition" onclick="toggleFavorite('${result.yid}', this)">❤</button>`;
                actionBtns += `<button class="bg-red-655 hover:bg-red-700 text-white rounded-lg px-2.5 py-1 text-[10px] font-bold transition" onclick="if(confirm('Supprimer cette vidéo ?')) window.location.href='/delete?id=${result.yid}'">Supprimer</button>`;
                actionBtns += `</div>`;
 
                cardDiv.innerHTML = `
                    <div class="video-thumb-container relative aspect-video bg-neutral-950 overflow-hidden">
                        <img data-src="/thumbnail/${result.yid}" src="" class="video-thumbnail w-full h-full object-cover lazy" alt="Thumbnail" loading="lazy">
                        ${result.isGz ? '<span class="absolute bottom-2 right-2 bg-neutral-900/90 text-neutral-300 text-[9px] px-1.5 py-0.5 rounded border border-neutral-750 font-semibold">📦 zip</span>' : ''}
                    </div>
                    <div class="video-info flex-1 flex flex-col justify-between gap-3">
                        <div class="min-w-0">
                            <div class="video-title" title="${result.fileName}">
                                ${result.fileName}
                            </div>
                            <div class="flex flex-col gap-1.5">
                                ${result.uploader ? `
                                    <div class="flex items-center gap-1.5 mt-1">
                                        <img src="/channel-logo/${encodeURIComponent(result.uploader)}" alt="Logo" class="w-5 h-5 rounded-full object-cover border border-neutral-850">
                                        <a href="/channel?name=${encodeURIComponent(result.uploader)}" onclick="event.stopPropagation();" class="text-neutral-400 hover:text-white transition text-xs font-semibold truncate">
                                            ${result.uploader}
                                        </a>
                                    </div>
                                ` : ''}
                                <div class="flex flex-wrap gap-1 mt-1">
                                    ${tagsHtml}
                                </div>
                            </div>
                        </div>
                        ${actionBtns}
                    </div>
                `;
                resultsList.appendChild(cardDiv);
            });

            if (end >= filteredVideos.length) {
                loadMoreContainer.classList.add('hidden');
            } else {
                loadMoreContainer.classList.remove('hidden');
            }
        }

        const fuse = new Fuse(allVideos, {
            keys: ['fileName', 'uploader'],
            threshold: 0.3,
            distance: 100,
            ignoreLocation: true
        });

        const thumbObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.src = img.dataset.src;
                    img.classList.remove('lazy');
                    obs.unobserve(img);
                }
            });
        }, { rootMargin: '200px' });

        function observeLazyImages() {
            document.querySelectorAll('img.lazy').forEach(img => thumbObserver.observe(img));
        }

        renderVideos();
        observeLazyImages();

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', () => {
                currentPage++;
                renderVideos(true);
                observeLazyImages();
            });
        }

        if (searchInput) {
            searchInput.addEventListener('input', debounce(function() {
                const query = this.value.trim();
                filteredVideos = query.length === 0 ? [...allVideos] : fuse.search(query).map(r => r.item);
                renderVideos();
                observeLazyImages();
            }, 250));
        }

        function filterByTag(tag, element) {
            document.querySelectorAll('.filter-chip').forEach(chip => {
                chip.classList.remove('active', 'bg-blue-600/25', 'border-blue-500/40', 'text-blue-400');
                chip.classList.add('bg-neutral-900', 'border-neutral-800', 'text-neutral-300');
            });
            element.classList.add('active', 'bg-blue-600/25', 'border-blue-500/40', 'text-blue-400');
            element.classList.remove('bg-neutral-900', 'border-neutral-800', 'text-neutral-300');
            
            filteredVideos = tag === 'all' ? [...allVideos] : allVideos.filter(v => v.tags.includes(tag));
            renderVideos();
            observeLazyImages();
        }

        function filterByChannel(uploader, element) {
            document.querySelectorAll('.filter-chip').forEach(chip => {
                chip.classList.remove('active', 'bg-blue-600/25', 'border-blue-500/40', 'text-blue-400');
                chip.classList.add('bg-neutral-900', 'border-neutral-800', 'text-neutral-300');
            });
            element.classList.add('active', 'bg-blue-600/25', 'border-blue-500/40', 'text-blue-400');
            element.classList.remove('bg-neutral-900', 'border-neutral-800', 'text-neutral-300');
            
            filteredVideos = uploader === 'all' ? [...allVideos] : allVideos.filter(v => v.uploader === uploader);
            renderVideos();
            observeLazyImages();
        }

        (function() {
            const lastUrlKey = 'last_visited_url';
            const sessionNavKey = 'has_navigated_this_session';
            const currentUrl = window.location.href;
            const lastUrl = localStorage.getItem(lastUrlKey);

            if (window.location.pathname === '/' && 
                lastUrl && 
                lastUrl !== currentUrl && 
                !lastUrl.includes('/suggestions') &&
                !sessionStorage.getItem(sessionNavKey)) {
                
                sessionStorage.setItem(sessionNavKey, 'true');
                window.location.href = lastUrl;
                return;
            }

            sessionStorage.setItem(sessionNavKey, 'true');
            localStorage.setItem(lastUrlKey, currentUrl);
        })();

        const commandForm = document.getElementById('commandForm');
        commandForm.addEventListener('submit', (e) => {
            if (!window.electronAPI) {
                e.preventDefault();
                const url = document.getElementById('commandInput').value;
                window.location.href = `/download?url=${encodeURIComponent(url)}`;
            }
        });

        async function addAllToQueue() {
            const ids = allVideos.map(v => v.yid);
            if (ids.length === 0) return;
            
            try {
                const response = await fetch('/queue/add_multiple', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ ids })
                });
                const data = await response.json();
                if (data.success) {
                    const btn = document.querySelector('a[href="/queue"]');
                    if (btn) {
                        btn.textContent = `File (${data.queueCount})`;
                    }
                    showToast('File d\'attente', 'Toutes les vidéos ont été ajoutées !', 'success');
                }
            } catch (e) {
                console.error(e);
                showToast('Erreur', 'Erreur lors de l\'ajout des vidéos à la file d\'attente.', 'error');
            }
        }

        async function toggleFollowChannel(channelName, channelUrl, btn) {
            const isCurrentlyFollowed = btn.classList.contains('bg-yellow-500');
            const endpoint = isCurrentlyFollowed ? '/channel/unfollow' : '/channel/follow';
            try {
                btn.disabled = true;
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ name: channelName, url: channelUrl })
                });
                const data = await response.json();
                if (data.success) {
                    if (data.isFollowing) {
                        btn.className = 'bg-yellow-500 hover:bg-yellow-600 text-neutral-900 rounded-full px-3 py-1 text-xs font-semibold transition';
                        btn.textContent = '✅ Suivi';
                        showToast('Chaîne suivie', `Vous suivez désormais ${channelName}. Les nouvelles vidéos seront téléchargées automatiquement.`, 'success');
                    } else {
                        btn.className = 'border border-yellow-550/50 hover:bg-yellow-500/10 text-yellow-400 rounded-full px-3 py-1 text-xs font-semibold transition';
                        btn.textContent = '➕ Suivre cette chaîne';
                        showToast('Chaîne retirée', `Vous ne suivez plus ${channelName}.`, 'success');
                    }
                } else {
                    showToast('Erreur', data.error || 'Action impossible.', 'error');
                }
            } catch (e) {
                console.error(e);
                showToast('Erreur', 'Impossible de modifier le suivi.', 'error');
            } finally {
                btn.disabled = false;
            }
        }

        if (typeof io !== 'undefined') {
            const _sock = typeof socket !== 'undefined' ? socket : io();
            _sock.on('channel-check-started', data => {
                if (data.total > 0) showToast('Sync chaînes', `Vérification de ${data.total} chaîne(s) suivie(s)...`, 'info');
            });
            _sock.on('channel-new-videos', data => {
                showToast('Nouvelles vidéos', `${data.count} nouvelle(s) vidéo(s) de <strong>${data.channelName}</strong> ajoutée(s) au téléchargement.`, 'success');
            });
            _sock.on('channel-check-finished', data => {
                if (data.totalAdded > 0) {
                    showToast('Sync terminée', `${data.totalAdded} nouvelle(s) vidéo(s) ajoutée(s) au total.`, 'success');
                }
            });
        }
    </script>
</body>
</html>
