<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YouTube Downloader - Suggestions</title>
    
    <link href="/tailwind.css" rel="stylesheet">
    <link href="/roboto.css" rel="stylesheet">
    <script src="socket.io.js"></script>
    <script src="renderer.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-[#0f0f0f] text-neutral-100 min-h-screen font-sans">
    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[1060] flex flex-col gap-2 max-w-sm w-full px-4 pointer-events-none"></div>

    <nav class="sticky top-0 z-50 bg-[#0f0f0f]/90 backdrop-blur-md border-b border-neutral-800 px-6 py-3 flex flex-wrap items-center justify-between gap-4">
        <a class="flex items-center gap-2 text-white font-bold" href="/">
            <img src="/favicon.ico" width="30" height="30" alt="">
            <div class="flex flex-col">
                <strong>YouTube Downloader</strong>
                <span class="text-[10px] text-neutral-400 -mt-1">v<%= typeof appVersion !== 'undefined' ? appVersion : '' %></span>
            </div>
        </a>
        
        <div class="flex-1 max-w-xl mx-4">
            <form id="commandForm" class="flex flex-col m-0 w-full">
                <div class="flex items-center gap-2">
                    <input class="bg-neutral-900 border border-neutral-800 text-white rounded-full px-4 py-2 text-sm w-full focus:outline-none focus:border-blue-500 transition" type="text" id="commandInput" placeholder="Coller une URL YouTube..." required>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white rounded-full px-4 py-2 text-sm font-semibold transition" type="submit">Télécharger</button>
                    <button type="button" class="border border-neutral-750 hover:bg-neutral-850 rounded-full p-2 text-sm transition" title="Changer le dossier de téléchargement" onclick="changeFolder()">📂</button>
                </div>
                <small class="text-[10px] text-neutral-500 text-center mt-1">Fichier backlog : <%= typeof backlogFile !== 'undefined' ? backlogFile : '' %></small>
            </form>
        </div>

        <div class="flex items-center gap-2 flex-wrap text-sm">
            <a href="/patchnotes" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">📜 Notes</a>
            <a href="/suggestions" class="bg-blue-605 hover:bg-blue-700 text-white rounded-full px-4 py-1.5 font-semibold transition">✨ Suggestions</a>
            <a href="/favorites" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Favoris (<%= typeof favoritesCount !== 'undefined' ? favoritesCount : 0 %>)</a>
            <a href="/queue" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">File (<%= typeof queueCount !== 'undefined' ? queueCount : 0 %>)</a>
            <a href="/playlists" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Playlists</a>
            <a href="/history" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Historique</a>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 mt-8">
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6 text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-xl font-bold text-white mb-4">Rechercher des suggestions</h2>
            <form action="/suggestions" method="GET" class="flex gap-2 justify-center">
                <input type="text" name="q" class="bg-neutral-950 border border-neutral-800 text-white rounded-full px-4 py-2 text-sm w-full focus:outline-none focus:border-blue-500 transition" placeholder="Rechercher des vidéos sur YouTube..." value="<%= query %>" required>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-full px-5 py-2 text-sm font-semibold transition">Rechercher</button>
            </form>
        </div>

        <% if (errorMsg) { %>
            <div class="bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl p-4 text-center max-w-xl mx-auto mb-8">
                <%= errorMsg %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6" id="suggestionsList">
            <% if (results && results.length > 0) { %>
                <% results.forEach(function(video) { %>
                    <% 
                        let thumbUrl = `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`;
                        if (video.thumbnails && video.thumbnails.length > 0) {
                            thumbUrl = video.thumbnails[video.thumbnails.length - 1].url;
                        }
                        let durStr = '';
                        if (video.duration) {
                            const minutes = Math.floor(video.duration / 60);
                            const seconds = Math.floor(video.duration % 60);
                            durStr = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                        }
                    %>
                    <div class="bg-neutral-900 border border-neutral-800 hover:border-neutral-700 rounded-2xl overflow-hidden flex flex-col h-full transition duration-200">
                        <div class="relative aspect-video bg-neutral-950 overflow-hidden">
                            <img src="<%= thumbUrl %>" class="w-full h-full object-cover" alt="Thumbnail" loading="lazy">
                            <% if (durStr) { %>
                                <span class="absolute bottom-2 right-2 bg-black/85 text-white px-2 py-0.5 rounded text-[10px] font-semibold"><%= durStr %></span>
                            <% } %>
                        </div>
                        <div class="p-4 flex-1 flex flex-col justify-between gap-4">
                            <div>
                                <div class="text-white font-semibold text-sm line-clamp-2 leading-tight mb-2" title="<%= video.title %>"><%= video.title %></div>
                                <div class="text-neutral-400 text-xs truncate mb-1"><%= video.uploader || video.channel || 'Chaîne inconnue' %></div>
                                <% if (video.view_count) { %>
                                    <div class="text-neutral-500 text-[10px]"><%= video.view_count.toLocaleString() %> vues</div>
                                <% } %>
                            </div>
                            <div>
                                <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg py-2 text-xs font-bold transition flex items-center justify-center gap-1" onclick="downloadVideo('<%= video.id %>')">
                                    📥 Télécharger
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else if (!errorMsg) { %>
                <div class="col-span-full text-center text-neutral-500 py-16">
                    Aucune suggestion trouvée. Essayez une autre recherche.
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function downloadVideo(id) {
            const url = `https://www.youtube.com/watch?v=${id}`;
            if (window.electronAPI && window.electronAPI.setTitle) {
                window.electronAPI.setTitle(url);
                showToast('Téléchargement', 'Téléchargement lancé avec succès !', 'success');
            } else {
                window.location.href = `/download?url=${encodeURIComponent(url)}`;
            }
        }
    </script>
</body>
</html>
