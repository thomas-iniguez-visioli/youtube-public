<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YouTube Downloader - Notes de mise à jour</title>
    
    <link href="/tailwind.css" rel="stylesheet">
    <link href="/roboto.css" rel="stylesheet">
    <script src="socket.io.js"></script>
    <script src="renderer.js"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-[#0f0f0f] text-neutral-100 min-h-screen font-sans">
    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[1060] flex flex-col gap-2 max-w-sm w-full px-4 pointer-events-none"></div>

    <nav class="sticky top-0 z-50 bg-[#0f0f0f]/90 backdrop-blur-md border-b border-neutral-800 px-6 py-3 flex flex-wrap items-center justify-between gap-4">
        <a class="flex items-center gap-2 text-white font-bold" href="/">
            <img src="/favicon.ico" width="30" height="30" alt="">
            <div class="flex flex-col">
                <strong>YouTube Downloader</strong>
                <span class="text-[10px] text-neutral-400 -mt-1">v<%= typeof appVersion !== 'undefined' ? appVersion : '' %></span>
            </div>
        </a>
        
        <div class="flex-1 max-w-xl mx-4">
            <form id="commandForm" class="flex flex-col m-0 w-full">
                <div class="flex items-center gap-2">
                    <input class="bg-neutral-900 border border-neutral-800 text-white rounded-full px-4 py-2 text-sm w-full focus:outline-none focus:border-blue-500 transition" type="text" id="commandInput" placeholder="Coller une URL YouTube..." required>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white rounded-full px-4 py-2 text-sm font-semibold transition" type="submit">Télécharger</button>
                    <button type="button" class="border border-neutral-750 hover:bg-neutral-850 rounded-full p-2 text-sm transition" title="Changer le dossier de téléchargement" onclick="changeFolder()">📂</button>
                </div>
                <small class="text-[10px] text-neutral-500 text-center mt-1">Fichier backlog : <%= typeof backlogFile !== 'undefined' ? backlogFile : '' %></small>
            </form>
        </div>

        <div class="flex items-center gap-2 flex-wrap text-sm">
            <a href="/suggestions" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">✨ Suggestions</a>
            <a href="/favorites" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Favoris (<%= typeof favoritesCount !== 'undefined' ? favoritesCount : 0 %>)</a>
            <a href="/queue" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">File (<%= typeof queueCount !== 'undefined' ? queueCount : 0 %>)</a>
            <a href="/playlists" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Playlists</a>
            <a href="/history" class="border border-neutral-750 hover:bg-neutral-850 text-neutral-300 rounded-full px-4 py-1.5 font-medium transition">Historique</a>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-6 mt-8">
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 shadow-2xl mb-12">
            <div class="flex items-center justify-between mb-6 border-b border-neutral-800 pb-4">
                <h1 class="text-2xl font-bold flex items-center gap-3 text-white">
                    <span>📜</span> Notes de mise à jour
                </h1>
                <a href="/" class="border border-neutral-700 hover:bg-neutral-800 text-neutral-200 rounded-full px-4 py-1.5 text-xs font-semibold transition">Retour à l'accueil</a>
            </div>
            
            <div class="prose prose-invert max-w-none text-neutral-300 space-y-6 patchnotes-rendered">
                <%- htmlContent %>
            </div>
        </div>
    </div>
</body>
</html>
