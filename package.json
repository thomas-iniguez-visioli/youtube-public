{
  "name": "youtube",
  "version": "2.1.26",
  "type": "module",
  "description": "youtube local",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i src/client-dist/tailwind-input.css -o src/client-dist/tailwind.css --minify",
    "prepush": "bun test",
    "postpush": "gh signoff",
    "start": "bun run tailwindcss -i src/client-dist/tailwind-input.css -o src/client-dist/tailwind.css ; electron .",
    "test": "bun test",
    "dist": "electron-builder --win",
    "dist:local": "cmd /c \"set WIN_CSC_LINK=spartan_arbinger.pfx&& electron-builder --win\"",
    "watch:css": "bun run tailwindcss -i src/client-dist/tailwind-input.css -o src/client-dist/tailwind.css --watch"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "ejs": "^7.0.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.9",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.0.0",
    "launchdarkly-electron-client-sdk": "^1.7.0",
    "morgan": "^1.12.1",
    "proxy-from-env": "^2.1.0",
    "rollbar": "^4.0.0",
    "socket.io": "^4.4.1",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "electron",
    "video",
    "streaming",
    "node"
  ],
  "author": "spartan_arbinger",
  "license": "MIT",
  "build": {
    "appId": "com.arbinger.youtube",
    "icon": "src/client-dist/app-icon.png",
    "files": [
      "src/**/*",
      "client-dist/**/*",
      "signing-certs/**/*",
      "package.json",
      "patchnotes.json",
      "rollbar.config.cjs",
      "launchdarkly.config.cjs",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.key",
      "!**/*.pem",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "win": {
      "signtoolOptions": {
        "publisherName": [
          "spartan_arbinger"
        ]
      },
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": "dmg",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "publish": [
        "github"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thomas-iniguez-visioli",
        "repo": "youtube-public",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "differentialPackage": false
    }
  }
}
