{
  "name": "youtube",
  "version": "1.17.9",
  "type": "module",
  "description": "youtube local",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "build": "bun i helmet cors ; bun x @tailwindcss/cli -i src/client-dist/tailwind-input.css -o src/client-dist/tailwind.css ; bun x electron-rebuild",
    "prepush": "bun test",
    "postpush": "gh signoff",
    "start": "bun x @tailwindcss/cli -i src/client-dist/tailwind-input.css -o src/client-dist/tailwind.css && electron .",
    "test": "bun test ./tests/*.test.js",
    "dist": "electron-builder --win",
    "dist:local": "cmd /c \"set WIN_CSC_LINK=spartan_arbinger.pfx&& electron-builder --win\""
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "ejs": "^7.0.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.9",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.0.0",
    "launchdarkly-electron-client-sdk": "^1.7.0",
    "morgan": "^1.12.1",
    "proxy-from-env": "^2.1.0",
    "rollbar": "^4.0.0",
    "socket.io": "^4.4.1",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "electron",
    "video",
    "streaming",
    "node"
  ],
  "author": "arbinger",
  "license": "MIT",
  "build": {
    "appId": "com.arbinger.youtube",
    "icon": "src/client-dist/app-icon.png",
    "files": [
      "**/*",
      "!**/*.pfx"
    ],
    "win": {
      "signtoolOptions": {
        "publisherName": [
          "spartan_arbinger"
        ]
      },
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": "dmg",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "publish": [
        "github"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thomas-iniguez-visioli",
        "repo": "youtube-public",
        "releaseType": "draft"
      }
    ]
  }
}
